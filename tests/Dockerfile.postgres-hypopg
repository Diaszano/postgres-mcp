ARG PG_VERSION=15
FROM postgres:${PG_VERSION}

# Install HypoPG (via package or compile from source fallback)
RUN apt-get update && \
    (apt-get install -y --no-install-recommends postgresql-${PG_MAJOR}-hypopg || \
     (apt-get install -y build-essential git postgresql-server-dev-${PG_MAJOR} && \
      git clone --depth 1 https://github.com/HypoPG/hypopg.git /tmp/hypopg && \
      make -C /tmp/hypopg install && \
      rm -rf /tmp/hypopg)) && \
    rm -rf /var/lib/apt/lists/*

# Add initialization script to create extensions in template1
RUN echo "CREATE EXTENSION IF NOT EXISTS pg_stat_statements; CREATE EXTENSION IF NOT EXISTS hypopg;" \
  > /docker-entrypoint-initdb.d/00-create-extensions.sql
